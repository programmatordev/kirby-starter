{
  "name": "programmatordev/kirby-starter",
  "description": "An opinionated Kirby CMS starter with DDEV, Vite, Blade, Tailwind CSS, and Alpine.js",
  "type": "project",
  "license": "0BSD",
  "keywords": ["kirby", "kirby-cms", "kirby-starter", "cms", "starter", "ddev", "vite", "tailwindcss", "alpinejs", "blade"],
  "authors": [
    {
      "name": "Programmator",
      "email": "hotline@programmator.dev",
      "homepage": "https://programmator.dev"
    }
  ],
  "require": {
    "php": ">=8.3.0",
    "getkirby/cms": "^5.6",
    "arnoson/kirby-vite": "^6.0",
    "beebmx/kirby-env": "^5.2",
    "leitsch/kirby-blade": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "site/classes/"
    }
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "optimize-autoloader": true
  },
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 kirby/router.php"
    ]
  }
}
