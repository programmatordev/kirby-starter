# Enable Kirby's debug mode.
APP_DEBUG=true

# Stable random values used to protect preview and media URLs and sign cookies.
APP_CONTENT_SALT=
APP_COOKIE_KEY=

# Default language for single-language websites.
# Multilanguage websites use the locale configured for each language.
APP_LANGUAGE=en

# Default Panel language before login or when the user has no valid language configured.
APP_PANEL_LANGUAGE=en

# Kirby Deploy webhook token used on the remote server.
DEPLOY_TOKEN=

# Staging deployment
DEPLOY_STAGING_HOST=
DEPLOY_STAGING_USER=
DEPLOY_STAGING_PASSWORD=
DEPLOY_STAGING_REMOTE_DIR=./
DEPLOY_STAGING_DRY_RUN=true
DEPLOY_STAGING_VERBOSE=false
DEPLOY_STAGING_FTP_SSL_FORCE=true
DEPLOY_STAGING_URL=
DEPLOY_STAGING_TOKEN=
DEPLOY_STAGING_CALL_WEBHOOKS=false

# Production deployment
DEPLOY_PRODUCTION_HOST=
DEPLOY_PRODUCTION_USER=
DEPLOY_PRODUCTION_PASSWORD=
DEPLOY_PRODUCTION_REMOTE_DIR=./
DEPLOY_PRODUCTION_DRY_RUN=true
DEPLOY_PRODUCTION_VERBOSE=false
DEPLOY_PRODUCTION_FTP_SSL_FORCE=true
DEPLOY_PRODUCTION_URL=
DEPLOY_PRODUCTION_TOKEN=
DEPLOY_PRODUCTION_CALL_WEBHOOKS=false
